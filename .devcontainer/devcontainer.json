{
  "name": "Chamunda RE Enterprise • Project Chhaya (Codespace)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Project Chhaya Mobile Agent Gateway",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "postStartCommand": "nohup python3 cloud_mirror_server.py > /tmp/chhaya_server.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
