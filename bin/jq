#!/usr/bin/env python3
import sys, json

def main():
    args = sys.argv[1:]
    filter_expr = args[0] if args else "."
    
    # Read stdin
    raw = sys.stdin.read()
    if not raw.strip():
        return
    try:
        data = json.loads(raw)
    except Exception as e:
        sys.stderr.write(f"Invalid JSON: {e}\n")
        sys.exit(1)

    if filter_expr in [".", ""]:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return

    # Basic dot access (.key1.key2)
    curr = data
    parts = filter_expr.strip(".").split(".")
    for p in parts:
        if isinstance(curr, dict) and p in curr:
            curr = curr[p]
        elif isinstance(curr, list) and p.isdigit():
            curr = curr[int(p)]
        else:
            curr = None
            break

    if curr is not None:
        if isinstance(curr, (dict, list)):
            print(json.dumps(curr, indent=2, ensure_ascii=False))
        else:
            print(curr)

if __name__ == "__main__":
    main()
